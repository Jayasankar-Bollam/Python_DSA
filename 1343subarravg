arr=[2,2,2,2,5,5,5,8]
n=len(arr)
k = 3
threshold = 4
ans=0
for i in range(n):
    for j in range(i,n):
          temp=[]
          sum=0
          for m in range(i,j+1):
               temp.append(arr[m])
               sum+=arr[m]
          if len(temp)==k:
               avg=sum/k
               if avg>=threshold:
                    ans+=1
print(ans)
 




#optimal
arr=[2,2,2,2,5,5,5,8]
n=len(arr)
k = 3
threshold = 4
ans=0
l=0
temp=0
for r in range(n):
     temp+=arr[r]

     if(r-l==k):
          temp-=arr[l]
          l+=1


     if (r-l+1==k):
          if (temp/k)>=threshold:
               ans+=1
print(ans)
